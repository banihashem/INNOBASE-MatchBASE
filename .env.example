# ==============================================================================
# MatchBASE — Environment Configuration Example (.env.example)
# ==============================================================================
# This template lists required and optional server-side configuration variables.
# Never commit credentials, tokens, or secret values to this file or repository.
# Never prefix model or database credentials with NEXT_PUBLIC_.
# ==============================================================================

# Database Persistence (PostgreSQL 18)
DATABASE_URL=
MATCHBASE_DATABASE_URL=
MATCHBASE_TEST_DATABASE_PASSWORD=

# Runtime Environment and Origin
MATCHBASE_ENVIRONMENT=
MATCHBASE_ORIGIN=
MATCHBASE_DIGEST_KEY=

# Local Simulators and Synthetic Fixtures (Local development/test only; forbidden in production)
MATCHBASE_OIDC_SIMULATOR=
MATCHBASE_SYNTHETIC_FIXTURE=

# Model and AI Provider Credentials (Server-Side Only)
# Canonical runtime key for external model routing; strictly server-side
MATCHBASE_OPENROUTER_API_KEY=
