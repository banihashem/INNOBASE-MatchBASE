{
  "name": "@innobase/matchbase",
  "version": "0.0.0-private",
  "private": true,
  "description": "Private MatchBASE autonomous delivery workspace",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run governance:check && pnpm run slice1:evidence:check && pnpm run slice2:evidence:check && pnpm run slice3:evidence:check && pnpm run snapshot:check && pnpm run boundary:check && pnpm run protected:check && pnpm run secrets:scan && pnpm run secrets:scan:independent && pnpm run secrets:scan:history && pnpm run dependency:check && pnpm run license:check && pnpm -r --if-present check",
    "check:dev": "pnpm run format:check && pnpm run lint && pnpm run boundary:check && pnpm run protected:check && pnpm run secrets:scan && pnpm -r --if-present check",
    "check:full": "pnpm run check",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test && pnpm run test:slice1:api && pnpm run test:slice2:api && pnpm run test:admin && node --test --test-concurrency=1 test/*.test.mjs test/slice3/*.test.mjs",
    "test:unit": "pnpm -r --workspace-concurrency=1 --if-present test",
    "test:integration": "pnpm run test:slice1:api && pnpm run test:slice2:api && pnpm run test:admin && node --test --test-concurrency=1 test/*.test.mjs test/slice3/*.test.mjs",
    "test:slice1:api": "pnpm --filter @matchbase/application build && pnpm --filter @matchbase/security build && node --test test/slice1/api/*.test.mjs",
    "test:slice2:api": "pnpm --filter @matchbase/application build && pnpm --filter @matchbase/security build && node --test --test-concurrency=1 test/slice2/api/*.test.mjs test/slice2/repository/*.test.mjs",
    "test:admin": "pnpm --filter @matchbase/data build && pnpm --filter @matchbase/application build && node --test test/admin/*.test.mjs && pnpm exec vitest run --config test/admin/vitest.admin.config.mjs",
    "test:consultant-output-v2": "pnpm --filter @matchbase/contracts build && node scripts/test-consultant-output-v2.mjs",
    "seed:consultant-output-v2": "pnpm --filter @matchbase/contracts build && pnpm --filter @matchbase/application build && node scripts/seed-consultant-output-v2.mjs",
    "reset:consultant-output-v2": "node scripts/reset-consultant-output-v2.mjs",
    "verify:consultant-output-v2:db": "pnpm --filter @matchbase/contracts build && pnpm --filter @matchbase/application build && node scripts/verify-consultant-output-v2-db.mjs",
    "seed:consultant-output-v3": "pnpm --filter @matchbase/contracts build && pnpm --filter @matchbase/application build && node scripts/seed-consultant-output-v3.mjs",
    "verify:consultant-output-v3:db": "pnpm --filter @matchbase/contracts build && pnpm --filter @matchbase/application build && node scripts/verify-consultant-output-v3-db.mjs",
    "test:consultant-v3:openrouter": "pnpm --filter @matchbase/contracts build && pnpm --filter @matchbase/application build && node scripts/test-consultant-v3-openrouter.mjs",
    "test:ci": "pnpm run snapshot:prepare && pnpm run build && pnpm run check && pnpm run test && pnpm run test:standalone:repeat && pnpm run test:browser",
    "slice1:validate:local": "node scripts/validate-slice1-local.mjs",
    "slice2:validate:local": "node scripts/validate-slice2-local.mjs",
    "slice3:validate:local": "pnpm --filter @matchbase/contracts build && pnpm --filter @matchbase/ai-evidence build && node scripts/validate-slice3-local.mjs",
    "governance:check": "node scripts/validate-governance.mjs",
    "slice1:evidence:check": "node scripts/validate-slice1-evidence.mjs",
    "slice2:evidence:check": "node scripts/validate-slice2-evidence.mjs",
    "slice3:evidence:check": "node scripts/validate-slice3-local.mjs",
    "slice3:evidence:generate": "node scripts/generate-slice3-evidence.mjs",
    "slice3:wrapper:record": "node scripts/record-slice3-wrapper-result.mjs",
    "slice3:qualify:live": "pnpm --filter @matchbase/application build && node scripts/qualify-slice3-live.mjs",
    "slice3:qualify:staging:preflight": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-live.mjs",
    "slice3:qualify:staging:execute": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-live.mjs --execute",
    "slice3:qualify:staging:validate": "pnpm --filter @matchbase/ai-evidence build && node scripts/validate-slice3-staging-live.mjs",
    "slice3:qualify:staging:successor:v2:preflight": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v2.mjs",
    "slice3:qualify:staging:successor:v2:execute": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v2.mjs --execute",
    "slice3:qualify:staging:successor:v3:preflight": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v3.mjs",
    "slice3:qualify:staging:successor:v3:execute": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v3.mjs --execute",
    "slice3:qualify:staging:successor:v4:preflight": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v4.mjs",
    "slice3:qualify:staging:successor:v4:execute": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v4.mjs --execute",
    "slice3:qualify:staging:successor:v5:preflight": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v5.mjs",
    "slice3:qualify:staging:successor:v5:execute": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v5.mjs --execute",
    "slice3:qualify:staging:successor:v6:preflight": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v6.mjs",
    "slice3:qualify:staging:successor:v6:execute": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v6.mjs --execute",
    "slice3:qualify:staging:successor:v7:preflight": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v7.mjs",
    "slice3:qualify:staging:successor:v7:execute": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v7.mjs --execute",
    "slice3:qualify:staging:successor:v8:preflight": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v8.mjs",
    "slice3:qualify:staging:successor:v8:execute": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v8.mjs --execute",
    "slice3:qualify:staging:successor:v9:preflight": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v9.mjs",
    "slice3:qualify:staging:successor:v9:execute": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v9.mjs --execute",
    "slice3:qualify:staging:successor:v10:preflight": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v10.mjs",
    "slice3:qualify:staging:successor:v10:execute": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v10.mjs --execute",
    "slice3:qualify:staging:successor:v11:preflight": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v11.mjs",
    "slice3:qualify:staging:successor:v11:execute": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v11.mjs --execute",
    "slice3:qualify:staging:successor:v12:preflight": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v12.mjs",
    "slice3:qualify:staging:successor:v12:execute": "pnpm --filter @matchbase/ai-evidence build && node scripts/qualify-slice3-staging-successor-v12.mjs --execute",
    "slice3:qualify:staging:converge:v13:preflight": "pnpm --filter @matchbase/ai-evidence build && node scripts/finalize-slice3-staging-qualification-v13.mjs",
    "slice3:qualify:staging:converge:v13:execute": "pnpm --filter @matchbase/ai-evidence build && node scripts/finalize-slice3-staging-qualification-v13.mjs --execute",
    "slice3:qualify:staging:azure:v2": "pnpm --filter @matchbase/ai-evidence build && pnpm --filter @matchbase/application build && node scripts/qualify-staging-openrouter-azure-v2.mjs --execute",
    "staging:route:v4:register": "node scripts/register-staging-route-policy-v4.mjs --execute",
    "staging:route:v4:verify": "node scripts/register-staging-route-policy-v4.mjs --verify",
    "slice3:qualify:staging:credential:v3:preflight": "node scripts/qualify-slice3-openrouter-credential-successor-v3.mjs",
    "slice3:qualify:staging:credential:v3:execute": "node scripts/qualify-slice3-openrouter-credential-successor-v3.mjs --execute",
    "slice3:qualify:staging:credential:v4:preflight": "node scripts/qualify-slice3-openrouter-credential-successor-v4.mjs",
    "slice3:qualify:staging:credential:v4:execute": "node scripts/qualify-slice3-openrouter-credential-successor-v4.mjs --execute",
    "slice3:qualify:v5:preflight": "node scripts/qualify-slice3-live-v5.mjs",
    "slice3:qualify:v5:execute": "node scripts/qualify-slice3-live-v5.mjs --execute",
    "slice3:sign:v5:s3": "node scripts/sign-slice3-v5-s3-durable.mjs",
    "boundary:check": "node scripts/verify-boundaries.mjs",
    "protected:check": "node scripts/validate-protected-baseline.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "secrets:scan:independent": "node scripts/run-secretlint.mjs",
    "secrets:scan:history": "node scripts/secret-history-scan.mjs",
    "dependency:check": "node scripts/dependency-policy.mjs",
    "dependency:audit": "pnpm audit --audit-level=high",
    "license:check": "node scripts/license-policy.mjs",
    "lint": "oxlint . --deny-warnings",
    "test:browser": "pnpm --filter @matchbase/security build && playwright test && node scripts/scan-slice1-runtime-artifacts.mjs",
    "test:standalone:cold": "pnpm --filter @matchbase/web test:standalone",
    "test:standalone:repeat": "pnpm --filter @matchbase/web test:standalone:repeat",
    "snapshot:prepare": "pnpm --filter @matchbase/artifact-indexer build && node scripts/prepare-dashboard-snapshot.mjs",
    "snapshot:check": "node scripts/validate-dashboard-snapshot.mjs --actual",
    "snapshot:generate": "pnpm --filter @matchbase/artifact-indexer build && node scripts/generate-dashboard-snapshot.mjs",
    "snapshot:verify-sources": "node scripts/validate-dashboard-snapshot.mjs --actual --require-sources",
    "p4:reporting:qualify": "pnpm --filter @matchbase/reporting build && node scripts/qualify-p4-reporting.mjs",
    "p4:candidate:generate": "node scripts/generate-p4-candidate.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@secretlint/quick-start": "13.0.4",
    "@playwright/test": "1.62.1",
    "oxlint": "1.78.0",
    "prettier": "3.9.6",
    "secretlint": "13.0.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
