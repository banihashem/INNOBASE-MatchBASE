{
  "name": "@matchbase/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node ../../scripts/package-next-standalone.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
